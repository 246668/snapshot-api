# Required: comma-separated exact origins allowed to embed screenshots.
# Use origins only; paths and wildcards are not supported.
SCREENSHOT_ALLOWED_ORIGINS=https://www.mydomain.com,https://mydomain.com

# Example local site origin (use instead of the production values locally):
# SCREENSHOT_ALLOWED_ORIGINS=http://localhost:4321

# Local Windows development only. Omit in Netlify production.
PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optional tuning values
# SCREENSHOT_NAVIGATION_TIMEOUT_MS=15000
# SCREENSHOT_SETTLE_DELAY_MS=750
# SCREENSHOT_MAX_REQUESTS=150
